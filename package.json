  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
